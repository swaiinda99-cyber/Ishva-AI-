# Ishva AI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to git.

# Google OAuth credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Session secret (any long random string)
SESSION_SECRET=your_long_random_session_secret_here

# Frontend URL (for CORS and OAuth redirect)
FRONTEND_URL=http://localhost:5173

# Backend port
PORT=4000

# Node environment
NODE_ENV=development

# Future: AI API keys (add as you integrate each)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_AI_API_KEY=
